    {
      "name": "ReCheckPassengerCount",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const responseData = pm.response.json();",
              "",
              "const chennaiToCoimbatore = responseData.filter(booking => ",
              "    booking.departCity === \"Chennai\" && booking.arrivalCity === \"Coimbatore\"",
              ");",
              "",
              "const passengerCount = chennaiToCoimbatore.reduce((sum, booking) => sum + booking.passengerCount, 0);",
              "",
              "pm.globals.set(\"IntrimCount\", passengerCount);",
              "",
              "pm.test(\"ReCheckPassengerCount\", function () {",
              "    pm.expect(passengerCount).to.eql(4);",
              "});"
