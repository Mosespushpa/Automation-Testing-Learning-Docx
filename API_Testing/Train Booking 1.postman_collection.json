      "name": "CheckPassengerCount",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const responseData = pm.response.json();",
              "",
              "const chennaiToCoimbatore = responseData.filter(booking => booking.departCity === \"Chennai\" && booking.arrivalCity === \"Coimbatore\");",
              "",
              "const passengerCount = chennaiToCoimbatore.length;",
              "",
              "pm.globals.set(\"InitialCount\", passengerCount);",
              "",
              "pm.test(\"CheckPassengerCount\", function () {",
              "    pm.expect(passengerCount).to.eql(1);",
              "});"
            ]
          }
        }
      ],
