    {
      "name": "DeleteBooking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const responseData = pm.response.json();",
              "",
              "const chennaiToCoimbatore = responseData.filter(booking => booking.departCity === \"Chennai\" && booking.arrivalCity === \"Coimbatore\");",
              "",
              "const finalCount = chennaiToCoimbatore.length;",
              "",
              "pm.globals.set(\"FinalCount\", finalCount);",
              "",
              "const initialCount = pm.globals.get(\"InitialCount\");",
              "",
              "pm.test(\"ValidatePassengerCount\", function () {",
              "    pm.expect(Number(finalCount)).to.eql(Number(initialCount));",
              "});"
            ]
          }
        }
      ],
